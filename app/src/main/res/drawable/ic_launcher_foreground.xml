<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-Sidebike launcher icon (v2): a line-art motorbike/sidecar with a code chevron and motion
  lines, on a deep navy background. Drawn as stroked paths so it stays crisp at 48dp and reads
  well under every adaptive-icon mask (all content within the 66dp safe zone).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- rear wheel -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,68m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
    <!-- front wheel -->
    <path
        android:fillColor="#00000000"
        android:pathData="M74,68m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <!-- frame -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,58 L44,44 L64,44 L70,60"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5.5" />
    <!-- handlebar / fork -->
    <path
        android:fillColor="#00000000"
        android:pathData="M64,44 L66,36 L75,35"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />
    <!-- code chevron on the frame (developer sidecar) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M52,49 L57,54 L52,59"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4.5" />
    <!-- motion lines -->
    <path
        android:fillColor="#00000000"
        android:pathData="M20,34 L30,34"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4" />
    <path
        android:fillColor="#00000000"
        android:pathData="M17,42 L28,42"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4" />
</vector>
