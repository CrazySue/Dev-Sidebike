    <string name="about_title">关于 Dev-Sidebike</string>
    <string name="about_version">版本 %1$s（alpha）</string>
    <string name="about_body">Dev-Sidebike 是 Dev-Sidecar 的 Android 重写版：通过 VpnService 提供系统级防污染 DNS，并在本机运行 HTTP/HTTPS 代理，为开发者的网络访问提供加速与诊断能力。</string>
    <string name="about_upstream_title">上游项目</string>
    <string name="about_upstream_body">Dev-Sidecar · docmirror · MPL-2.0 许可</string>
    <string name="about_license_title">开源许可</string>
    <string name="about_license_body">本应用基于 Material Design 3 构建，使用 AndroidX / Jetpack Compose（Apache-2.0）。上游 Dev-Sidecar 以 Mozilla Public License 2.0 发布，本应用的对应源码同样以 MPL-2.0 提供。</string>
    <string name="about_tech_title">技术栈</string>
    <string name="about_tech_body">Jetpack Compose · Material 3 · Kotlin Coroutines · VpnService（纯 Kotlin 后端内核）</string>

