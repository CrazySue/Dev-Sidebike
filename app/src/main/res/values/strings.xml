    <!-- ============================ Certificate guide ============================ -->
    <string name="cert_hero_title">CA 证书状态</string>
    <string name="cert_status_installed">已安装</string>
    <string name="cert_status_not_installed">未安装</string>
    <string name="cert_status_not_generated">尚未生成</string>
    <string name="cert_hero_desc_installed">系统已信任本应用的用户 CA，开启 MITM 后即可改写指定域名的 HTTP 流量。</string>
    <string name="cert_hero_desc_not_installed">开启 MITM 需要安装并信任本应用的 CA 证书，安装前 MITM 改写不可用。</string>
    <string name="cert_hero_desc_not_generated">请先在「设置 → MITM 与证书」中开启 MITM 并启动一次服务，以生成本地 CA。</string>
    <string name="cert_install">安装 CA 证书</string>
    <string name="cert_export">导出 CA 证书</string>
    <string name="cert_steps_title">安装步骤</string>
    <string name="cert_step1_title">1. 开启 MITM 增强</string>
    <string name="cert_step1_desc">在「设置 → MITM 与证书」中开启 MITM，并启动一次服务以生成 CA 证书。</string>
    <string name="cert_step2_title">2. 安装证书</string>
    <string name="cert_step2_desc">点击「安装 CA 证书」，在系统证书安装器中确认安装。系统会提示“您的数据可能被监控”。</string>
    <string name="cert_step3_title">3. 确认信任状态</string>
    <string name="cert_step3_desc">打开系统「设置 → 安全 → 加密与凭据 → 信任的凭据 → 用户」，确认存在 Dev-Sidebike CA。</string>
    <string name="cert_step4_title">4. 返回验证</string>
    <string name="cert_step4_desc">回到本应用点击「重新检测」，状态显示“已安装”即完成，之后可重启服务使用 MITM 改写。</string>
    <string name="cert_limits_title">能力边界</string>
    <string name="cert_limits_body">Android 7 及以上仅部分应用（例如浏览器）信任用户 CA。不信任用户 CA 的应用无法进行 MITM 改写，但仍可通过 VPN DNS 获得防污染解析。MITM 默认关闭，属于增强项。</string>
    <string name="cert_generated_hint">尚未生成 CA：请先开启 MITM 并启动一次服务</string>
    <string name="cert_install_failed">无法打开证书安装器，请尝试导出证书后手动安装</string>
    <string name="cert_export_failed">CA 证书尚未生成，无法导出</string>
    <string name="cert_export_chooser">导出 Dev-Sidebike CA 证书</string>
    <string name="cert_share_subject">Dev-Sidebike CA 证书</string>
    <string name="cert_open_settings">打开设置</string>

