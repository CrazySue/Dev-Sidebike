<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay (never part of a release build).

  Exposes a fault-injection receiver for QA so real-device failure paths can be exercised with adb:
  the receiver requires android.permission.DUMP, which only the adb shell uid (and system/root) hold,
  and it only exists in the debug variant (applicationId dev.sidebike.app.debug).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="dev.sidebike.app.debug.FaultInjectionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.sidebike.app.debug.KILL_PROXY" />
                <action android:name="dev.sidebike.app.debug.CRASH_ENGINE" />
                <action android:name="dev.sidebike.app.debug.DUMP_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
